# Create your own bot token with @BotFather. Never commit .env.
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Keep the dashboard bound to localhost unless you have added authentication.
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5000

# Optional shared secret for the local Telegram-to-dashboard webhook.
# Set a long random value here if you enable it; both processes read this file.
DASHBOARD_WEBHOOK_TOKEN=generate_your_own_secret
DASHBOARD_WEBHOOK_URL=http://127.0.0.1:5000/webhook/telegram

# Flask session/signing secret. Replace with a random value.
FLASK_SECRET_KEY=generate_your_own_secret
